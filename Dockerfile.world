# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS web
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    set -eu; if [ -f /run/secrets/proxy_ca ]; then \
    export SSL_CERT_FILE=/run/secrets/proxy_ca; \
    sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::https::CaInfo="$SSL_CERT_FILE" update; \
    apt-get -o Acquire::https::CaInfo="$SSL_CERT_FILE" install -y --no-install-recommends python3 git curl ca-certificates; \
    else apt-get update && apt-get install -y --no-install-recommends python3 git curl ca-certificates; fi; \
    rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY world/ world/
COPY scripts/build_world.py scripts/build_world.py
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca \
    CURL_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca; fi; \
    python3 scripts/build_world.py --output /site

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/rf-skill-harness
COPY pyproject.toml LICENSE ./
COPY src/ src/
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    set -eu; if [ -f /run/secrets/proxy_ca ]; then \
    export SSL_CERT_FILE=/run/secrets/proxy_ca; \
    sed -i 's|http://archive.ubuntu.com/ubuntu|https://archive.ubuntu.com/ubuntu|g; s|http://security.ubuntu.com/ubuntu|https://security.ubuntu.com/ubuntu|g' /etc/apt/sources.list.d/ubuntu.sources; \
    apt-get -o Acquire::https::CaInfo="$SSL_CERT_FILE" update; \
    apt-get -o Acquire::https::CaInfo="$SSL_CERT_FILE" install -y --no-install-recommends \
    ca-certificates gnuradio python3-numpy python3-yaml python3-pip python3-pytest; \
    else apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates gnuradio python3-numpy python3-yaml python3-pip python3-pytest; fi; \
    rm -rf /var/lib/apt/lists/*; \
    python3 -m pip install --no-deps --no-build-isolation --break-system-packages .; \
    groupadd --gid 10001 rf && useradd --uid 10001 --gid rf --create-home rf
COPY --from=web /site /opt/gnuradio-world
ARG SOURCE_REVISION=development
LABEL org.opencontainers.image.source="https://github.com/wa200508/RF-Skill-Harness" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="GPL-3.0-or-later AND Apache-2.0"
USER rf
WORKDIR /workspace
EXPOSE 8090
HEALTHCHECK --interval=5s --start-period=15s CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8090/health.json', timeout=2)"
ENTRYPOINT ["python3", "-m", "rf_skill_harness.world_server"]
