# syntax=docker/dockerfile:1
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    QT_QPA_PLATFORM=xcb QT_OPENGL=software QT_X11_NO_MITSHM=1 \
    LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe
ARG SOURCE_REVISION=development
LABEL org.opencontainers.image.source="https://github.com/wa200508/RF-Skill-Harness" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /opt/rf-skill-harness
COPY pyproject.toml LICENSE ./
COPY src/ src/
COPY scripts/ scripts/
COPY tests/ tests/
# All GUI libraries belong to the server. No host X socket, GPU device, elevated
# privileges or host-installed GNU Radio/Qt/GTK is needed. One install layer also
# keeps development practical on Docker daemons using the vfs storage driver.
RUN --mount=type=secret,id=proxy_ca,mode=0444 \
    set -eu; \
    sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources; \
    if [ -f /run/secrets/proxy_ca ]; then \
      apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca update; \
      apt-get -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends \
        ca-certificates gnuradio python3-pip python3-setuptools python3-wheel python3-numpy \
        python3-yaml python3-matplotlib python3-pytest gir1.2-gtk-3.0 python3-gi-cairo \
        xvfb x11vnc novnc websockify openbox mousepad xterm wmctrl x11-utils mesa-utils \
        libgl1-mesa-dri libglx-mesa0 libegl1 fonts-dejavu-core adwaita-icon-theme; \
    else \
      # Bootstrap the trust store using signed distro repositories.
      sed -i 's|https://|http://|g' /etc/apt/sources.list.d/ubuntu.sources; \
      apt-get update; apt-get install -y --no-install-recommends ca-certificates; \
      sed -i 's|http://|https://|g' /etc/apt/sources.list.d/ubuntu.sources; \
      apt-get update; apt-get install -y --no-install-recommends \
        gnuradio python3-pip python3-setuptools python3-wheel python3-numpy \
        python3-yaml python3-matplotlib python3-pytest gir1.2-gtk-3.0 python3-gi-cairo \
        xvfb x11vnc novnc websockify openbox mousepad xterm wmctrl x11-utils mesa-utils \
        libgl1-mesa-dri libglx-mesa0 libegl1 fonts-dejavu-core adwaita-icon-theme; \
    fi; \
    python3 -m pip install --no-deps --no-build-isolation --no-cache-dir --break-system-packages .; \
    chmod -R a+rX /opt/rf-skill-harness; \
    groupadd --gid 10001 rf; useradd --uid 10001 --gid rf --create-home rf; \
    rm -rf /var/lib/apt/lists/*
USER rf
WORKDIR /workspace
EXPOSE 6080
HEALTHCHECK --interval=10s --timeout=3s --start-period=60s \
    CMD python3 -c "import urllib.request,json; assert json.load(urllib.request.urlopen('http://127.0.0.1:6080/health.json',timeout=2))['status']=='ready'"
ENTRYPOINT ["python3", "-m", "rf_skill_harness.companion_server"]
CMD ["--workspace", "/workspace"]
